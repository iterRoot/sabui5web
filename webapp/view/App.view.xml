<mvc:View xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:w="sap.ui.integration.widgets" controllerName="sap.ui.demo.todo.controller.App" displayBlock="true">
	<App>
		<Page>
			<!-- HEADER -->
			<customHeader>
				<f:ShellBar title="DIMENSION" showNotifications="true" showProductSwitcher="true" showSearch="false">
					<f:profile>
						<!-- <Avatar icon="sap-icon://person-placeholder"/> -->
						<Avatar displayShape="Circle" displaySize="S" src="sap-icon://person-placeholder"/>

					</f:profile>
				</f:ShellBar>
			</customHeader>
			<content>				
				<!-- NAVIGATION -->
				<IconTabBar class="sapUiResponsiveContentPadding">
					<items>
						<IconTabFilter text="Master Data" />
						<IconTabFilter text="Job Master"/>
						<IconTabFilter text="Expense"/>
						<IconTabFilter text="Revenue"/>
						<IconTabFilter text="Reports"/>
					</items>
				</IconTabBar>
				<!-- SECTION TITLE -->
				<Title text="Master Data" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiResponsiveMargin"/>
				<!-- SOFT CONTAINER -->

				<!-- <Panel expandable="true" expanded="true" stickyHeader="true" height="250px" headerText="Panel with a sticky header" width="auto" class="sapUiResponsiveMargin"> -->
				<Panel height="200px" width="auto" class="sapUiResponsiveMargin">

					<content>
					<f:GridContainer>
						<f:layout>
							<f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
						</f:layout>

						<w:Card manifest="cards/BPMaster.json">
							<w:layoutData>
								<f:GridContainerItemLayoutData columns="3" rows="2"/>
							</w:layoutData>
					
						</w:Card>
						<w:Card manifest="cards/kpiCard.json">
							<w:layoutData>
								<f:GridContainerItemLayoutData columns="3" rows="2"/>
							</w:layoutData>
					
						</w:Card>

					</f:GridContainer>
					</content>
				</Panel>
				<Title text="Job Master" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiResponsiveMargin"/>
				<Panel height="200px" width="auto" class="sapUiResponsiveMargin">
					<content>
						<f:GridContainer>
							<f:layout>
								<f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
							</f:layout>

							<w:Card manifest="cards/kpiCard.json">
								<w:layoutData>
									<f:GridContainerItemLayoutData columns="3" rows="2"/>
								</w:layoutData>
							</w:Card>

							<w:Card manifest="cards/kpiCard.json">
								<w:layoutData>
									<f:GridContainerItemLayoutData columns="3" rows="2"/>
								</w:layoutData>
							</w:Card>

														<w:Card manifest="cards/kpiCard.json">
								<w:layoutData>
									<f:GridContainerItemLayoutData columns="3" rows="2"/>
								</w:layoutData>
							</w:Card>
							<w:Card manifest="cards/kpiCard.json">
								<w:layoutData>
									<f:GridContainerItemLayoutData columns="3" rows="2"/>
								</w:layoutData>
							</w:Card>


						</f:GridContainer>
					</content>
				</Panel>

				<Title text="Expense" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiResponsiveMargin"/>
				<Panel height="250px" width="auto" class="sapUiResponsiveMargin">

					<content>
					<f:GridContainer>
						<f:layout>
							<f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
						</f:layout>

						<w:Card manifest="cards/kpiCard.json">
							<w:layoutData>
								<f:GridContainerItemLayoutData columns="3" rows="2"/>
							</w:layoutData>
					
						</w:Card>

					</f:GridContainer>
					</content>
				</Panel>


				<Title text="Revenue" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiResponsiveMargin"/>
				<Panel height="200px" width="auto" class="sapUiResponsiveMargin">

					<content>
					<f:GridContainer>
						<f:layout>
							<f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
						</f:layout>

						<w:Card manifest="cards/kpiCard.json">
							<w:layoutData>
								<f:GridContainerItemLayoutData columns="3" rows="2"/>
							</w:layoutData>
					
						</w:Card>

					</f:GridContainer>
					</content>
				</Panel>


				<Title text="Reports" level="H2" class="sapUiSmallMarginBegin sapUiSmallMarginTop sapUiResponsiveMargin"/>
				<Panel height="200px" width="auto" class="sapUiResponsiveMargin">

					<content>
					<f:GridContainer>
						<f:layout>
							<f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/>
						</f:layout>

						<w:Card manifest="cards/kpiCard.json">
							<w:layoutData>
								<f:GridContainerItemLayoutData columns="3" rows="2"/>
							</w:layoutData>
					
						</w:Card>

					</f:GridContainer>
					</content>
				</Panel>

			</content>

		</Page>

	</App>
</mvc:View>
